{
    "manifest_version":  3,
    "name":  "Conector 02",
    "version":  "0.4.5",
    "description":  "Integra um gerador de links ao painel local.",
    "permissions":  [
                        "alarms",
                        "tabs"
                    ],
    "host_permissions":  [
                             "http://127.0.0.1:3030/*",
                             "http://localhost:3030/*",
                             "https://www.mercadolivre.com.br/*",
                             "https://mercadolivre.com.br/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://www.mercadolivre.com.br/*",
                                                "https://mercadolivre.com.br/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ]
}
