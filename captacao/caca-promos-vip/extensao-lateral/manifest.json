{
  "manifest_version": 3,
  "name": "Caça Promos VIP — Participantes",
  "version": "0.4.1",
  "minimum_chrome_version": "116",
  "description": "Leitura supervisionada do texto visível no popup Pesquisar membros, com revisão local e CSV. OCR alternativo.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Caça Promos VIP — Participantes"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
