+import { describe, expect, it } from 'vitest';
+import { buildCustomButtons, CUSTOM_BUTTON_DEFAULTS, validateCustomButtons } from './custom-buttons';
+
+const NUMBER = '5511999990000';
+
+describe('Caça Promos VIP customized reply buttons', () => {
+  it('starts with exactly 2 editable reply buttons and the preserved invitation', () => {
+    const p = buildCustomButtons(NUMBER, CUSTOM_BUTTON_DEFAULTS);
+    expect(validateCustomButtons(CUSTOM_BUTTON_DEFAULTS)).toBeNull();
+    expect(p).toMatchObject({
+      number: NUMBER,
+      title: 'Convite Caça Promos VIP 👑',
+      footer: 'Caça Promos VIP',
+      buttons: [
+        { type: 'reply', displayText: 'Entrar no grupo', id: 'aceitar_grupo' },
+        { type: 'reply', displayText: 'Não tenho interesse', id: 'recusar_grupo' },
+      ],
+    });
+    expect((p.buttons as unknown[])).toHaveLength(2);
+  });
+
+  it('edits text independently of the buttons', () => {
+    const v = { ...CUSTOM_BUTTON_DEFAULTS, title: 'Novo título', description: 'Texto atualizado!', footer: '' };
+    expect(buildCustomButtons(NUMBER, v)).toMatchObject({ title: 'Novo título', description: 'Texto atualizado!' });
+    expect(buildCustomButtons(NUMBER, v)).not.toHaveProperty('footer');
+  });
+
+  it('allows 1, 2 or 3 replies without ghost buttons', () => {
+    expect((buildCustomButtons(NUMBER, { ...CUSTOM_BUTTON_DEFAULTS, buttonCount: '1' }).buttons as unknown[])).toHaveLength(1);
+    expect((buildCustomButtons(NUMBER, { ...CUSTOM_BUTTON_DEFAULTS, buttonCount: '3' }).buttons as unknown[])).toHaveLength(3);
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, buttonCount: '3' })).toBeNull();
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, buttonCount: '4' })).toMatch(/1 a 3/);
+  });
+
+  it('does not allow missing message content or invalid labels and identifiers', () => {
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, description: ' ' })).toMatch(/mensagem/);
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, button1Text: '' })).toMatch(/botão 1/);
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, button2Text: 'I'.repeat(21) })).toMatch(/20 caracteres/);
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, button2Id: 'aceitar_grupo' })).toMatch(/diferentes/);
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, button2Id: 'a value with spaces' })).toMatch(/ID/);
+    expect(validateCustomButtons({ ...CUSTOM_BUTTON_DEFAULTS, description: 'a'.repeat(1025) })).toMatch(/1024/);
+  });
+});
