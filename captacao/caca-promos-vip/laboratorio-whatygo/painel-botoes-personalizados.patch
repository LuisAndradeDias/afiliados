+/**
+ * Safe, editable quick-reply messages for the Caça Promos VIP lab.
+ * No sending is performed here: this module only validates and builds a payload.
+ */
+export const CUSTOM_BUTTON_PRESET = 'btn_custom_cpv';
+
+export type CustomButtonValues = Record<string, string>;
+
+export const CUSTOM_BUTTON_DEFAULTS: CustomButtonValues = {
+  preset: CUSTOM_BUTTON_PRESET,
+  title: 'Convite Caça Promos VIP 👑',
+  description: 'Olá! 👋\n\nGostaria de participar do nosso grupo VIP e receber as melhores promoções diretamente no WhatsApp?\n\nEscolha uma opção abaixo:',
+  footer: 'Caça Promos VIP',
+  buttonCount: '2',
+  button1Text: 'Entrar no grupo',
+  button1Id: 'aceitar_grupo',
+  button2Text: 'Não tenho interesse',
+  button2Id: 'recusar_grupo',
+  button3Text: 'Saiba mais',
+  button3Id: 'cpv_saiba_mais',
+};
+
+const cleaned = (v: string | undefined) => (v ?? '').trim();
+
+export const customButtonCount = (v: CustomButtonValues): number => Number(v.buttonCount);
+
+export function validateCustomButtons(v: CustomButtonValues): string | null {
+  const count = customButtonCount(v);
+  if (!Number.isInteger(count) || count < 1 || count > 3) return 'Selecione de 1 a 3 botões de resposta.';
+  if (!cleaned(v.description)) return 'Preencha o texto da mensagem.';
+  if (cleaned(v.description).length > 1024) return 'O texto da mensagem deve ter até 1024 caracteres.';
+  if (cleaned(v.title).length > 80) return 'O título deve ter até 80 caracteres.';
+  if (cleaned(v.footer).length > 60) return 'O rodapé deve ter até 60 caracteres.';
+  const ids = new Set<string>();
+  for (let n = 1; n <= count; n += 1) {
+    const label = cleaned(v[`button${n}Text`]);
+    const id = cleaned(v[`button${n}Id`]);
+    if (!label) return `Preencha o texto do botão ${n}.`;
+    if (Array.from(label).length > 20) return `O texto do botão ${n} deve ter no máximo 20 caracteres.`;
+    if (!id || !/^[A-Za-z0-9_-]{1,64}$/.test(id)) return `O ID do botão ${n} deve ter entre 1 e 64 letras, números, _ ou -.`;
+    if (ids.has(id)) return 'Os IDs dos botões precisam ser diferentes.';
+    ids.add(id);
+  }
+  return null;
+}
+
+export function buildCustomButtons(number: string, v: CustomButtonValues): Record<string, unknown> {
+  const count = customButtonCount(v);
+  const buttons = Array.from({ length: count }, (_, index) => {
+    const n = index + 1;
+    return { type: 'reply', displayText: cleaned(v[`button${n}Text`]), id: cleaned(v[`button${n}Id`]) };
+  });
+  const payload: Record<string, unknown> = {
+    number,
+    description: cleaned(v.description),
+    buttons,
+  };
+  if (cleaned(v.title)) payload.title = cleaned(v.title);
+  if (cleaned(v.footer)) payload.footer = cleaned(v.footer);
+  return payload;
+}
